# Copie este arquivo para ".env" e preencha os valores. O ".env" NÃO vai para o GitHub.

# Porta do servidor (padrão: 3000)
PORT=3000

# Senha de acesso ao painel administrativo (/admin) — mínimo 6 caracteres
ADMIN_PASSWORD=""

# Zoho Mail — API OAuth 2.0 (recomendado)
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_ACCOUNT_ID=""

# Zoho Mail — remetente e SMTP (alternativa ao OAuth)
ZOHO_USER=""
ZOHO_PASS=""

# Assinatura das sessões do painel admin (gere um texto aleatório longo)
SESSION_SECRET=""

# Banco de dados de produção (Upstash Redis). Na Vercel são criadas automaticamente
# ao conectar o banco em Storage. Localmente, se vazias, usa-se data/database.json.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""